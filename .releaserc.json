{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/github", {
      "assets": [
        { "path": "garmin-app/bin/DriftGuard.prg", "label": "DriftGuard for Edge 1050" },
        { "path": "garmin-app/bin/SHA256SUMS.txt", "label": "SHA-256 checksum" }
      ]
    }]
  ]
}
